# Rails Production Environment Variables
RAILS_ENV=production
SECRET_KEY_BASE=generate_with_bin_rails_secret

# Database Configuration
POSTGRES_USER=esrog_user
POSTGRES_PASSWORD=change_this_to_a_strong_password_123
POSTGRES_DB=esrog_shuk_production

# CORS Configuration (comma separated origins allowed to access backend)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Twilio SMS API Keys (Optional)
twilio_account_sid=your_account_sid
twilio_auth_token=your_auth_token
twilio_number=1234567890
